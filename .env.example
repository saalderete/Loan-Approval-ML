# Copy to .env and fill in what you need. Every variable is optional.

# Where model versions and the registry live (default: ./models)
LOAN_ML_MODELS_DIR=./models
# Where raw/processed data are stored (default: ./data)
LOAN_ML_DATA_DIR=./data
# Runtime state: monitoring + audit SQLite DB and training-job logs (default: ./var)
LOAN_ML_STATE_DIR=./var

# Admin token for training jobs and model promotion via the API.
# Leave empty to disable admin endpoints entirely.
ADMIN_TOKEN=

# Streamlit -> API mode. Leave empty and the dashboard runs the model in-process.
API_URL=

# Optional AI Model Analyst (server-side only; never exposed to the browser)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
AI_DAILY_REQUEST_LIMIT=200

# Public API rate limit (requests per minute per client)
RATE_LIMIT_PER_MINUTE=60
